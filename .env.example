# OrderFlow - local environment overrides
#
# Every variable below already has a working default for local development,
# so copying this file is only required when you need to diverge from it:
#
#   cp .env.example .env
#
# Values are consumed as ${VAR:default} placeholders by each service's
# application.properties. Never commit the resulting .env file.

# --- PostgreSQL (shared instance, one database per service) ---
DB_USERNAME=orderflow_user
DB_PASSWORD=orderflow_password
# Set per service when overriding the full JDBC URL:
#   order-service   -> jdbc:postgresql://localhost:5436/orders
#   payment-service -> jdbc:postgresql://localhost:5436/payments
# DB_URL=

# --- MongoDB (product catalog and stock reservations) ---
MONGO_URI=mongodb://localhost:27018/orderflow

# --- Redis (catalog cache and per-tenant rate limiting) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=admin

# --- Phase 7: OAuth2 resource server ---
JWT_ISSUER_URI=http://localhost:8090/issuer

# --- Phase 9: Lambda payment webhook ---
# Shared secret for Lambda -> Payment Service internal calls.
INTERNAL_API_KEY=
# Secret used to validate inbound webhook signatures.
PAYMENT_WEBHOOK_SECRET=
